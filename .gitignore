# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/

# Node / Vue
node_modules/
dist/
frontend/.vite/

# 数据与模型（体积大，不入仓）
data/
*.mp4
*.pt
*.safetensors
train/cache/
train/ckpt/
train/_*.log

# 结果集 JSON + 可视化段图入仓（体积可控，保证 clone 后 web 完整）；素材/临时帧不入仓
!backend/data/
!backend/data/results/
!backend/data/results/*.json
backend/data/assets/
backend/data/_tmp_frames/

# 日志
*.log
*.log.err

# 环境与密钥
.env
*.pem
*.key
*.p12

# 编辑器
.idea/
.vscode/
.DS_Store

